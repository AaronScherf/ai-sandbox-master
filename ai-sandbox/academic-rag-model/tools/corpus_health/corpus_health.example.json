{
  "version": 1,
  "academic_hub_root": "../../../academic-hub",
  "academic_notes_root": "../../../academic-hub/academic_notes",
  "required_roots": ["hub", "notes"],
  "courses": [],
  "max_hash_bytes": 8388608,
  "markdown_policies": [
    {
      "name": "course-summaries",
      "root": "notes",
      "glob": "*/summaries/*.md",
      "exclude_globs": [
        "*/summaries/generate_plots.md.md",
        "*/summaries/testing_html.md",
        "*/summaries/testing_html_export.md"
      ],
      "required_fields": ["title"],
      "check_index": true
    },
    {
      "name": "processed-note-markdown",
      "root": "notes",
      "glob": "*/**/processed_outputs/*.md",
      "exclude_globs": [
        "**/*.excalidraw.md",
        "**/*.narrated.md",
        "**/*__index.md"
      ],
      "required_fields": [],
      "check_index": true
    },
    {
      "name": "textbook-rag-frontmatter",
      "root": "notes",
      "glob": "*/textbooks*/processed_outputs/*/*.rag.md",
      "check_index": false
    }
  ]
}
