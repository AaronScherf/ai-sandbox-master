# ==========================================================================
# Template for ai-sandbox/.env -- copy this file to ai-sandbox/.env and fill
# in your own values. .env is gitignored; this example file is the only
# thing that should ever be committed.
#
# Only the academic-rag-model textbook conversion pipeline's and the
# utility-scripts/analyze_textbook study assistant's variables are listed
# here -- if other tools in this repo need their own env vars, add them to
# your local .env directly.
# ==========================================================================

# Your GCP project ID (not the numeric project number).
PROJECT_ID=your-gcp-project-id

# Name of the GPU Compute Engine VM this pipeline runs on. See
# academic-rag-model/gcp_instructions.md Step 1.3 for how to create one from
# scratch if you don't have one yet.
VM_INSTANCE_NAME=your-vm-instance-name

# Zone the VM lives in (not just the region -- e.g. us-east1-c, not us-east1).
GCP_ZONE=us-east1-c

# GCS bucket used to stage input PDFs and retrieve processed output.
BUCKET_NAME=your-bucket-name

# NOTE: TEXTBOOK_SUBDIR (which subfolder of academic-hub/ a given run reads
# from and writes to) is no longer set here -- it's run-specific, not
# per-machine config, so it's declared directly in gcp_instructions.md
# Step 0.2 alongside PDF_FILENAMES.

# Free-tier Gemini Developer API key (aistudio.google.com/apikey) used by
# utility-scripts/analyze_textbook/textbook_analysis.py. Not a GCP/Vertex
# credential -- no billing account needed. See analyze_instructions.md.
GEMINI_API_KEY=your-gemini-api-key
